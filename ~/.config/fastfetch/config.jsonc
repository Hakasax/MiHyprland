{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 12
    },
    "size": {
      "binaryPrefix": "jedec"
    },
    "separator": " ➜ "
  },
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo/logo.png",
    "width": 20,
    "height": 14,
    "padding": {
      "top": 0,
      "left": 1
    }
  },
  "modules": [
    "break",
    {
      "type": "host",
      "key": "Host",
      "keyColor": "#CBA6F7",
      "format": "{name}"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#94E2D5",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#74C7EC"
    },
    {
      "type": "packages",
      "key": "Paquetes",
      "keyColor": "#F9E2AF"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#F5C2E7",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#94E2D5",
      "format": "{pretty-name}"
    },
    {
      "type": "terminalfont",
      "key": "Fuentes",
      "keyColor": "#F5C2E7"
    },
    {
      "type": "command",
      "key": "WM",
      "keyColor": "#89DCEB",
      "text": "echo 'Hyprland'",
      "format": "{1}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#CBA6F7",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#94E2D5",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "Disco",
      "keyColor": "#74C7EC",
      "folders": ["/"],
      "format": "{size-used} / {size-total}"
    },
    "break",
    "colors"
  ]
}